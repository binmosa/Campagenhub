# Base URL of the backend API, INCLUDING the /api suffix.
# Local dev default (when unset): http://<current-host>:3001/api
# Production (Vercel env var):    https://api.<your-domain>/api
VITE_API_BASE_URL=http://localhost:3001/api

# Optional: token for HeroUI Pro developer tooling (CLI/MCP).
# NOT needed for npm install or builds — @heroui-pro/react is on the public npm registry.
HEROUI_AUTH_TOKEN=
