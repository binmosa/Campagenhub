# Base URL of the backend API, INCLUDING the /api suffix.
# Local dev default (when unset): http://<current-host>:3001/api
# Production (Vercel env var):    https://api.<your-domain>/api
VITE_API_BASE_URL=http://localhost:3001/api

# HeroUI Pro licence. @heroui-pro/react installs from npm as a stub whose
# postinstall downloads the real bundle, and that download needs a CI/CD
# licence key from the HeroUI Pro dashboard — the token `npx heroui-pro
# login` writes on a workstation is a different credential and is rejected
# with "Invalid or inactive CI/CD license key". Required for any build on a
# server (Vercel, Docker, CI); not needed locally once node_modules exists.
HEROUI_AUTH_TOKEN=

# Cloudflare Turnstile site key (public — it ships in the bundle). Leave it
# unset and the challenge widget is not rendered at all, which is what local
# development and the e2e run want. Must be paired with TURNSTILE_SECRET_KEY
# on the API, or the form will show a challenge the server never checks.
VITE_TURNSTILE_SITE_KEY=
