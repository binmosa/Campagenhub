# ============ Server ============
PORT=3001
# Bind address. Leave unset (0.0.0.0) inside Docker. On a bare server where a
# local nginx proxies to this process, set HOST=127.0.0.1 so the API is never
# reachable from outside the machine.
# HOST=127.0.0.1
# Comma-separated list of allowed browser origins (set to your Vercel domain(s) in production)
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in emails, payment redirects, Telegram broadcasts)
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for payment webhooks, e.g. https://api.your-domain.com)
PUBLIC_URL=http://localhost:3001
# Local fallback directory for uploads, used only when R2 is not configured
# (see below). Default: ./public relative to the process cwd.
UPLOADS_DIR=

# ============ Database (PostgreSQL) ============
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=campaignhub

# ============ Auth ============
# REQUIRED — the server refuses to start without it. Generate: openssl rand -base64 48
JWT_SECRET=

# ============ Seed accounts (local/dev only) ============
ENABLE_SEED=false
SEED_PASSWORD=

# ============ AI (OpenRouter) ============
# Get a key at https://openrouter.ai — when unset, AI features fall back to templates.
OPENROUTER_API_KEY=
# Any OpenRouter model slug, e.g. deepseek/deepseek-chat, qwen/qwen-2.5-72b-instruct
LLM_MODEL=deepseek/deepseek-chat
# Override only if not using OpenRouter (must be OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1

# FX rates source (USD-based JSON; default open.er-api.com, no key needed).
# Rates refresh daily; per-currency manual overrides live in the fx_rates table.
FX_RATES_URL=https://open.er-api.com/v6/latest/USD

# ============ Telegram ============
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ENABLE_TELEGRAM_POLLING=false

# ============ Email (Gmail app password) ============
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ============ Flutterwave ============
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=

# ============ PayPal ============
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ============ Telebirr ============
TELEBIRR_BASE_URL=
TELEBIRR_WEB_BASE_URL=
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
# base64 of the full PEM private key, single line: base64 -i private_key.pem | tr -d '\n'
TELEBIRR_PRIVATE_KEY_BASE64=
# Set to true ONLY for the raw-IP sandbox gateway (disables TLS verification)
TELEBIRR_ALLOW_INSECURE_TLS=false

# Optional: YouTube Data API v3 key — auto-verifies creators' YouTube subscriber
# claims on save (other platforms are verified by an admin in Follower claims).
YOUTUBE_API_KEY=

# Schema management. TypeORM auto-sync is ON outside production. On a fresh
# production database, boot once with DB_SYNCHRONIZE=true to create the
# schema, then remove it so deploys can never ALTER live tables.
DB_SYNCHRONIZE=false

# Flutterwave webhook shared hash. Set the same value in the Flutterwave
# dashboard (Settings -> Webhooks -> Secret hash). Without it the webhook
# endpoint refuses every call, because a forged one would mint a payout.
FLW_SECRET_HASH=

# Telebirr callbacks stay closed until their signature is verified with
# Telebirr's public key. Leave unset.
TELEBIRR_WEBHOOK_ENABLED=false

# Request throttling. The defaults in code are the production numbers
# (10 login attempts/min, 3 password-reset requests/min, 300 requests/min
# overall). Raise them only for an automated test run — there is no value
# that switches throttling off.
# THROTTLE_LOGIN=10
# THROTTLE_MEDIUM=300

# ============ Bot protection ============
# Cloudflare Turnstile guards sign-up and password reset. Leave the secret
# unset and the challenge is skipped entirely (local dev, CI). Get the pair
# from the Cloudflare dashboard → Turnstile; the site key is public and goes
# in the frontend build as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Number of reverse proxies in front of this process, for the rate limiter's
# client-IP lookup. 0 = trust nobody (correct when the API is reached
# directly). Set 1 behind nginx or Caddy, or every visitor shares one bucket
# and the limits fire on the wrong people.
TRUST_PROXY=0

# ============ File storage (Cloudflare R2) ============
# With these set, uploads go to R2 instead of the server's disk — which is
# what makes the app safe to redeploy, rebuild or move, since a server
# filesystem is temporary and pitch videos are not. Leave them empty and
# uploads fall back to UPLOADS_DIR on local disk (dev and CI do this).
#
# R2_ACCOUNT_ID     Cloudflare dashboard → R2 → account ID (the hex string)
# R2_BUCKET         the bucket name, e.g. campaignhubz-uploads
# R2_ACCESS_KEY_ID  R2 → Manage API tokens → Object Read & Write
# R2_PUBLIC_URL     where the browser loads files from. Use a custom domain
#                   (https://cdn.campaignhubz.com) rather than the r2.dev
#                   address, which is rate-limited and not meant for
#                   production traffic. Uploads refuse to run without it —
#                   storing a file nobody can load is worse than failing.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
