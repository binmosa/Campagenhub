# Copy to .deploy.env (gitignored) — used by `npm run deploy:frontend`.
DEPLOY_HOST=forge@YOUR_SERVER_IP
DEPLOY_KEY=~/private_key
DEPLOY_PATH=/home/forge/campaignhubz.com
# Optional. Site → Deployments → "Deploy hook" in Forge. With it set, the same
# command also runs the backend deploy, so one command ships everything.
# DEPLOY_HOOK=https://forge.laravel.com/servers/.../sites/.../deploy/http?token=...
