# Root compose configuration for the single-VPS stack.
# Copy to .env and fill in. backend/.env holds the application's own settings.

# The one domain the whole app is served from. A DNS A record for it must
# point at this VPS before `docker compose up` — Caddy needs it to issue the
# certificate.
APP_DOMAIN=campaignhubz.com

# Postgres. The API is handed these same values, so they cannot drift.
DB_USER=postgres
DB_PASSWORD=
DB_NAME=campaignhub

# Frontend build strategy:
#   Dockerfile           builds from source — needs a HeroUI Pro CI/CD licence
#                        key in ./heroui-ci-token.txt
#   Dockerfile.prebuilt  ships frontend/dist that you built locally
FRONTEND_DOCKERFILE=Dockerfile
